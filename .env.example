NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification token (content of the google-site-verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 ID (G-XXXXXXX). Loaded only after visitors accept analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Upstash Redis (free tier) for rate limiting the enquiry form across all server instances.
# Without these, an in-memory limiter is used (fine for local dev, not for serverless production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enquiry emails via Resend (https://resend.com, free tier: 3,000 emails/month)
RESEND_API_KEY=
# Where enquiries are sent (comma-separated). Defaults to the contact email in site-config.
LEAD_NOTIFICATION_EMAIL=info@spacesioberyl.com
# Sender on a domain verified in Resend, e.g. Spacesio Beryl <enquiries@spacesioberyl.com>
LEAD_FROM_EMAIL=
# "true" to also send the customer a confirmation email (needs the verified sender above)
LEAD_SEND_CONFIRMATION=false

# Newsletter: Resend audience that footer sign-ups are added to (Resend dashboard > Audiences)
RESEND_AUDIENCE_ID=
# "true" to email new subscribers a welcome note (needs the verified LEAD_FROM_EMAIL sender)
NEWSLETTER_SEND_WELCOME=false
